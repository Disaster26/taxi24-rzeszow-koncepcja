   "mainEntity": [
    {
     "@type": "Question",
     "name": "Czy jeździcie z Rzeszowa do Tyczyna, Boguchwały i Łańcuta?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Tak, całą dobę. Kursy poza miasto bez powrotu liczymy w taryfie 3 (8 zł/km) lub nocą w taryfie 4 (11 zł/km), plus opłata początkowa 10 zł."
     }
    },
    {
     "@type": "Question",
     "name": "Czy odbierzecie mnie z miejscowości pod Rzeszowem na lotnisko Jasionka?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Tak. Podaj adres i godzinę odbioru, przy przylocie numer lotu - lot monitorujemy, a czas oczekiwania jest bezpłatny."
     }
    },
    {
     "@type": "Question",
     "name": "Czy kurs z okolicy można wycenić z góry?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Tak, przy dłuższych kursach zapytaj o indywidualną wycenę - podamy cenę przy potwierdzeniu zamówienia."
     }
    },
    {
     "@type": "Question",
     "name": "Czy jeździcie na Słocinę i inne osiedla, których nie ma na liście?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Tak, jeździmy po całym Rzeszowie - wystarczy podać adres."
     }
    }
